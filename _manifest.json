{
  "manifest_version": 2,
  "id": "neko.files",
  "version": "0.4.1",
  "name": "Neko Files",
  "description": "按需读取授权QQ文档及单个压缩包成员；默认关闭，须配套可信上下文fork。",
  "author": {"name": "NekoLaska", "url": "https://github.com/znzsofficial"},
  "urls": {
    "repository": "https://github.com/RoselindLabs/neko-files",
    "documentation": "https://github.com/RoselindLabs/neko-files/blob/main/README.md"
  },
  "license": "MIT",
  "host_application": {"min_version": "1.3.15", "max_version": "1.3.15"},
  "sdk": {"min_version": "2.16.0", "max_version": "2.16.0"},
  "capabilities": ["api.call", "chat.get_all_streams", "message.get_by_id", "llm.generate"],
  "dependencies": [
    {"type": "plugin", "id": "maibot-team.snowluma-adapter", "version_spec": ">=1.1.5"},
    {"type": "python_package", "name": "aiohttp", "version_spec": ">=3.12"},
    {"type": "python_package", "name": "PyMuPDF", "version_spec": ">=1.26,<2"},
    {"type": "python_package", "name": "python-docx", "version_spec": ">=1.2,<2"},
    {"type": "python_package", "name": "openpyxl", "version_spec": ">=3.1,<4"}
  ],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
